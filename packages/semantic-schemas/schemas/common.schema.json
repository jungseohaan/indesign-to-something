  "rules": [
    {
      "id": "rule-background",
      "label": "BACKGROUND",
      "priority": 5,
      "conditions": [
        { "field": "isBackgroundOnly", "operator": "eq", "value": true }
      ],
      "confidence": 0.95
    },
    {
      "id": "rule-page-header",
      "label": "PAGE_HEADER",
      "priority": 10,
      "conditions": [
        { "field": "regionTag", "operator": "eq", "value": "TOP" },
        { "field": "textLength", "operator": "lt", "value": 50 }
      ],
      "confidence": 0.85
    },
    {
      "id": "rule-page-footer",
      "label": "PAGE_FOOTER",
      "priority": 10,
      "conditions": [
        { "field": "regionTag", "operator": "eq", "value": "BOTTOM" },
        { "field": "textLength", "operator": "lt", "value": 30 }
      ],
      "confidence": 0.85
    },
    {
      "id": "rule-figure",
      "label": "FIGURE",
      "priority": 15,
      "conditions": [
        { "field": "blockType", "operator": "eq", "value": "FIGURE" }
      ],
      "confidence": 0.9
    },
    {
      "id": "rule-table",
      "label": "TABLE",
      "priority": 15,
      "conditions": [
        { "field": "blockType", "operator": "eq", "value": "TABLE" }
      ],
      "confidence": 0.9
    },
    {
      "id": "rule-section-title",
      "label": "SECTION_TITLE",
      "priority": 20,
      "conditions": [
        { "field": "regionTag", "operator": "eq", "value": "FULL_WIDTH" },
        { "field": "dominantFontSize", "operator": "gte", "value": 1400 },
        { "field": "paragraphCount", "operator": "lte", "value": 3 }
      ],
      "confidence": 0.8
    }
  ],
  "relationRules": [
