  "rules": [
    {
      "id": "rule-chapter-title",
      "label": "CHAPTER_TITLE",
      "priority": 20,
      "conditions": [
        { "field": "hasNumberPrefix", "operator": "eq", "value": true },
        { "field": "numberPrefixPattern", "operator": "eq", "value": "roman" },
        { "field": "dominantFontSize", "operator": "gte", "value": 1600 }
      ],
      "confidence": 0.9
    },
    {
      "id": "rule-section-title-math",
      "label": "SECTION_TITLE",
      "priority": 25,
      "conditions": [
        { "field": "hasNumberPrefix", "operator": "eq", "value": true },
        { "field": "numberPrefixPattern", "operator": "eq", "value": "arabic_dot" },
        { "field": "dominantFontSize", "operator": "gte", "value": 1400 },
        { "field": "paragraphCount", "operator": "lte", "value": 3 }
      ],
      "confidence": 0.85
    },
    {
      "id": "rule-concept-box",
      "label": "CONCEPT_BOX",
      "priority": 30,
      "conditions": [
        { "field": "hasFill", "operator": "eq", "value": true },
        { "field": "hasStroke", "operator": "eq", "value": true },
        { "field": "textLength", "operator": "gt", "value": 20 }
      ],
      "confidence": 0.75
    },
    {
      "id": "rule-formula",
      "label": "FORMULA",
      "priority": 35,
      "conditions": [
        { "field": "hasEquation", "operator": "eq", "value": true },
        { "field": "paragraphCount", "operator": "lte", "value": 3 },
        { "field": "dominantAlignment", "operator": "eq", "value": "CenterJustify" }
      ],
      "confidence": 0.8
    },
    {
      "id": "rule-problem",
      "label": "PROBLEM",
      "priority": 40,
      "conditions": [
        { "field": "hasNumberPrefix", "operator": "eq", "value": true },
        { "field": "numberPrefixPattern", "operator": "eq", "value": "arabic_dot" },
        { "field": "dominantFontSize", "operator": "lte", "value": 1200 }
      ],
      "confidence": 0.8
    },
    {
      "id": "rule-sub-problem-circled",
      "label": "SUB_PROBLEM",
      "priority": 45,
      "conditions": [
        { "field": "hasNumberPrefix", "operator": "eq", "value": true },
        { "field": "numberPrefixPattern", "operator": "in", "value": ["circled", "parenthesized_arabic"] }
      ],
      "confidence": 0.75
    },
    {
      "id": "rule-example",
      "label": "EXAMPLE",
      "priority": 38,
      "conditions": [
        { "field": "firstLineText", "operator": "contains", "value": "예제" }
      ],
      "confidence": 0.85
    },
    {
      "id": "rule-tip-box",
      "label": "TIP_BOX",
      "priority": 50,
      "conditions": [
        { "field": "hasFill", "operator": "eq", "value": true },
        { "field": "textLength", "operator": "lt", "value": 200 },
        { "field": "regionTag", "operator": "in", "value": ["LEFT", "RIGHT"] }
      ],
      "confidence": 0.7
    },
    {
      "id": "rule-sidebar",
      "label": "SIDEBAR",
      "priority": 55,
      "conditions": [
        { "field": "regionTag", "operator": "in", "value": ["LEFT", "RIGHT"] },
        { "field": "textLength", "operator": "gt", "value": 0 },
        { "field": "textLength", "operator": "lt", "value": 100 }
      ],
      "confidence": 0.65
    }
  ],
  "relationRules": [
    {
      "id": "rel-solution-example",
      "type": "SOLUTION_FOR",
      "sourceLabel": "SOLUTION",
      "targetLabel": "EXAMPLE"
    },
    {
      "id": "rel-answer-problem",
      "type": "ANSWER_FOR",
      "sourceLabel": "ANSWER",
      "targetLabel": "PROBLEM"
    },
    {
      "id": "rel-sub-problem",
      "type": "PARENT_OF",
      "sourceLabel": "PROBLEM",
      "targetLabel": "SUB_PROBLEM"
    },
    {
      "id": "rel-choices-problem",
      "type": "PARENT_OF",
      "sourceLabel": "PROBLEM",
      "targetLabel": "CHOICES"
    }
  ],
  "layoutHints": [
    { "label": "CHAPTER_TITLE", "expectedRegions": ["TOP", "FULL_WIDTH"] },
    { "label": "SECTION_TITLE", "expectedRegions": ["TOP", "FULL_WIDTH"] },
    { "label": "SIDEBAR", "expectedRegions": ["LEFT", "RIGHT"] },
    { "label": "TIP_BOX", "expectedRegions": ["LEFT", "RIGHT", "MIDDLE"] }
  ]
}
